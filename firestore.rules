rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher(teacherId) { return signedIn() && request.auth.uid == teacherId; }
    match /teachers/{teacherId}/classes/{classId} {
      allow read, create, update, delete: if isTeacher(teacherId);
      match /students/{studentId} {
        allow read, create, update, delete: if isTeacher(teacherId);
      }
    }
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid && request.resource.data.maxPlayers <= 30;
      // Prototype game writes remain permissive; validate scores and answers on a trusted server before public tournaments.
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}
