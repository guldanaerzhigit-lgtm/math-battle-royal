rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function teacher(t){return signedIn() && request.auth.uid == t;}
  function admin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));}
  function verified(){return signedIn() && request.auth.token.email_verified == true;}
  function classTeacher(code){
   let codePath = /databases/$(database)/documents/classCodes/$(code);
   return signedIn() && exists(codePath) && get(codePath).data.teacherUid == request.auth.uid;
  }
  function classMember(code){
   let codePath = /databases/$(database)/documents/classCodes/$(code);
   return signedIn() && exists(codePath) && exists(/databases/$(database)/documents/teachers/$(get(codePath).data.teacherUid)/classes/$(get(codePath).data.classId)/students/$(request.auth.uid));
  }
  match /admins/{uid} {
   allow read: if teacher(uid);
   allow write: if false;
  }
  match /teacherInvites/{email} {
   allow read: if admin() || (verified() && request.auth.token.email == email && resource.data.status == "pending");
   allow create, update, delete: if admin();
   allow update: if admin() || (verified() && request.auth.token.email == email && resource.data.status == "pending" && request.resource.data.status == "accepted" && request.resource.data.acceptedUid == request.auth.uid && request.resource.data.email == resource.data.email);
  }
  match /teacherProfiles/{uid} {
   allow read: if teacher(uid) || admin();
   allow create: if teacher(uid) && verified() && request.resource.data.uid == uid && request.resource.data.role == "teacher" && request.resource.data.status == "active" && exists(/databases/$(database)/documents/teacherInvites/$(request.resource.data.inviteEmail)) && get(/databases/$(database)/documents/teacherInvites/$(request.resource.data.inviteEmail)).data.status == "accepted" && get(/databases/$(database)/documents/teacherInvites/$(request.resource.data.inviteEmail)).data.acceptedUid == uid && request.auth.token.email == request.resource.data.email;
   allow update: if admin() || (teacher(uid) && request.resource.data.uid == uid && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status);
   allow delete: if admin();
  }
  match /classCodes/{code} {
   allow read: if signedIn();
   allow create, update: if signedIn() && request.resource.data.teacherUid == request.auth.uid;
   allow delete: if signedIn() && resource.data.teacherUid == request.auth.uid;
  }
  match /classPublic/{code} {
   allow read: if signedIn();
   allow create, update: if signedIn() && request.resource.data.teacherUid == request.auth.uid;
   allow delete: if signedIn() && resource.data.teacherUid == request.auth.uid;
   match /assignments/{assignmentId} {
    allow read: if classTeacher(code) || classMember(code);
    allow create, update: if signedIn() && request.resource.data.teacherUid == request.auth.uid;
    allow delete: if signedIn() && resource.data.teacherUid == request.auth.uid;
    match /attempts/{attemptId} {
     allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid && classMember(code);
     allow read: if classTeacher(code) || (signedIn() && resource.data.studentUid == request.auth.uid);
     allow update, delete: if signedIn() && resource.data.studentUid == request.auth.uid;
    }
   }
  }
  match /teachers/{t}/classes/{c} {
   allow read, create, update, delete: if teacher(t);
   match /students/{s} {
    allow read, update, delete: if teacher(t);
    allow create: if teacher(t) || (signedIn() && request.auth.uid == s && request.resource.data.joinCode is string && get(/databases/$(database)/documents/classCodes/$(request.resource.data.joinCode)).data.teacherUid == t && get(/databases/$(database)/documents/classCodes/$(request.resource.data.joinCode)).data.classId == c);
   }
   match /questions/{questionId} {
    allow read, create, update, delete: if teacher(t);
   }
  }
  match /tournaments/{tournamentId} {
   allow read: if signedIn();
   allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid && request.resource.data.code == tournamentId && request.resource.data.roomCode is string && request.resource.data.joinCode is string;
   allow update, delete: if signedIn() && resource.data.hostUid == request.auth.uid;
   match /participants/{classCode} {
    allow read: if classTeacher(classCode) || classMember(classCode) || (signedIn() && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.hostUid == request.auth.uid);
    allow create: if classTeacher(classCode) && request.resource.data.teacherUid == request.auth.uid && request.resource.data.classCode == classCode;
    allow update, delete: if classTeacher(classCode) || (signedIn() && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.hostUid == request.auth.uid);
   }
  }
  match /rooms/{roomId} {
   allow read: if signedIn();
   allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid && request.resource.data.maxPlayers <= 30;
   allow update: if signedIn();
   allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
  }
 }
}