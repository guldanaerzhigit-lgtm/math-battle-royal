rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function teacher(t){return signedIn() && request.auth.uid == t;}
  function classMember(code){
   let codePath = /databases/$(database)/documents/classCodes/$(code);
   return signedIn() && exists(codePath) && exists(/databases/$(database)/documents/teachers/$(get(codePath).data.teacherUid)/classes/$(get(codePath).data.classId)/students/$(request.auth.uid));
  }
  match /classCodes/{code} {
   allow read: if signedIn();
   allow create, update: if signedIn() && request.resource.data.teacherUid == request.auth.uid;
   allow delete: if signedIn() && resource.data.teacherUid == request.auth.uid;
  }
  match /classPublic/{code} {
   allow read: if signedIn();
   allow create, update: if signedIn() && request.resource.data.teacherUid == request.auth.uid;
   allow delete: if signedIn() && resource.data.teacherUid == request.auth.uid;
   match /assignments/{assignmentId} {
    allow read: if signedIn() && (resource.data.teacherUid == request.auth.uid || classMember(code));
    allow create, update: if signedIn() && request.resource.data.teacherUid == request.auth.uid;
    allow delete: if signedIn() && resource.data.teacherUid == request.auth.uid;
    match /attempts/{attemptId} {
     allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid && classMember(code);
     allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || resource.data.teacherUid == request.auth.uid);
     allow update, delete: if signedIn() && resource.data.studentUid == request.auth.uid;
    }
   }
  }
  match /teachers/{t}/classes/{c} {
   allow read, create, update, delete: if teacher(t);
   match /students/{s} {
    allow read, update, delete: if teacher(t);
    allow create: if teacher(t) || (signedIn() && request.auth.uid == s && request.resource.data.joinCode is string && get(/databases/$(database)/documents/classCodes/$(request.resource.data.joinCode)).data.teacherUid == t && get(/databases/$(database)/documents/classCodes/$(request.resource.data.joinCode)).data.classId == c);
   }
   match /questions/{questionId} {
    allow read, create, update, delete: if teacher(t);
   }
  }
  match /rooms/{roomId} {
   allow read: if signedIn();
   allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid && request.resource.data.maxPlayers <= 30;
   allow update: if signedIn();
   allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
  }
 }
}